{
  "headers": [
    {
      "source": "/files/(.*\\.xlsx)",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" },
        { "key": "Content-Disposition", "value": "attachment" }
      ]
    },
    {
      "source": "/files/(.*\\.pptx)",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.openxmlformats-officedocument.presentationml.presentation" },
        { "key": "Content-Disposition", "value": "attachment" }
      ]
    }
  ]
}
